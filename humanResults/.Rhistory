Descriptive_Stats <- function(D) {
mean_D <- mean(D, na.rm = TRUE)
sd_D <- sd(D, na.rm = TRUE)
se_D <- sd_D / sqrt(sum(!is.na(D)))
CI_lower <- mean_D - 1.96 * se_D
CI_upper <- mean_D + 1.96 * se_D
result_des <- paste0("Mean: ", round(mean_D, 2),
" | SD: ", round(sd_D, 2),
" | 95% CI: [", round(CI_lower, 2), ", ", round(CI_upper, 2), "]")
return(result_des)
}
