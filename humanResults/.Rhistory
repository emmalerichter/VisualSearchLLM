small_step_model <- stepAIC(small_Psych_model, direction = "both")
summary(small_step_model)
# demographics
model_demo <- lm(IKDC ~ Alter + BMI + Geschlecht.m..1..w..2, data = Knie_data)
# add Nachbehandlung
model_Add_Clin <- lm(IKDC ~ Alter + BMI + Geschlecht.m..1..w..2 +
Nachbehandlung.Physio.1Ja + Nachbehandlung.Lymph.1Ja + Nachbeheandlung.Aktivitäten.1.Ja +                                        Nachbehandlung.Muskelaufbau.1Ja +                                 Motorschiene., data = Knie_data)
# Add psych
model_Add_Psych2 <- lm(IKDC ~ Alter + BMI + Geschlecht.m..1..w..2 +
Nachbehandlung.Physio.1Ja + Nachbehandlung.Lymph.1Ja + Nachbeheandlung.Aktivitäten.1.Ja +                                        Nachbehandlung.Muskelaufbau.1Ja +                                 Motorschiene.+
SBI_psych + Behandlungerfolg,
data = Knie_data)
summary(model_demo)
summary(model_Add_Clin)
summary(model_Add_Psych2)
anova(model_demo, model_Add_Clin, model_Add_Psych2)
#data and comparison
get_info <- function(model) {
summary_mod <- summary(model)
data.frame(
R2 = summary_mod$r.squared,
AdjR2 = summary_mod$adj.r.squared,
Fstat = summary_mod$fstatistic[1],
df1 = summary_mod$fstatistic[2],
df2 = summary_mod$fstatistic[3],
p = pf(summary_mod$fstatistic[1],
summary_mod$fstatistic[2],
summary_mod$fstatistic[3],
lower.tail = FALSE)
)
}
# Extract R² for each model
info1 <- get_info(model_demo)
info2 <- get_info(model_Add_Clin)
info32 <- get_info(model_Add_Psych2)
# Put into one table
models_table2 <- data.frame(
Step = c("1. Demographics", "2. + Clinical", "3. + Psych2"),
R2 = c(info1$R2, info2$R2, info32$R2),
AdjR2 = c(info1$AdjR2, info2$AdjR2, info32$AdjR2),
Fstat = c(info1$Fstat, info2$Fstat, info32$Fstat),
df1 = c(info1$df1, info2$df1, info32$df1),
df2 = c(info1$df2, info2$df2, info32$df2),
p = c(info1$p, info2$p, info32$p)
)
# Compute ΔR² between steps
models_table2$DeltaR <- c(
models_table2$R2[1],
models_table2$R2[2] - models_table2$R2[1],
models_table2$R2[3] - models_table2$R2[2]
)
# Round for readability
models_table2[, -1] <- round(models_table2[, -1], 4)
models_table2
# gives nested p values
