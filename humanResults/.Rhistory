#single variable analysis
analyze_postop <- function(data, outcome = "IKDC", treatments) {
results <- list()
for (treat in treatments) {
cat("\n=============================\n")
cat("Treatment:", treat, "\n")
formula_t <- as.formula(paste(outcome, "~", treat))
t_res <- t.test(formula_t, data = data)
print(t_res)
model <- lm(formula_t, data = data)
aov_res <- anova(model)
print(aov_res)
results[[treat]] <- list(
ttest = broom::tidy(t_res),
anova = broom::tidy(aov_res)
)
}
return(results)
}
postop_results <- analyze_postop(Knie_data, outcome = "IKDC", treatments = treatments)
